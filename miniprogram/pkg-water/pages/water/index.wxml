<view class="page">
  <!-- 顶部工具条：必须放在 canvas 外面。
       webgl 画布是原生组件，普通 view 叠在它上面在模拟器里会被盖住（同层渲染不可靠），
       所以这里改成上下分区布局，不做叠加。 -->
  <view class="topbar">
    <view class="seg">
      <view class="seg-item {{mode==='drop'?'on':''}}" data-m="drop" bindtap="onMode">投放</view>
      <view class="seg-item {{mode==='view'?'on':''}}" data-m="view" bindtap="onMode">视角</view>
      <view class="seg-item {{mode==='orbit'?'on':''}}" data-m="orbit" bindtap="onMode">环绕</view>
    </view>
    <view class="stat" wx:if="{{!loading}}">{{count}} 个物体 · {{perfNote || qualityName}}</view>
    <view class="stat" wx:else>装载中…</view>
    <view class="help" bindtap="onHelp">?</view>
  </view>

  <!-- 三步上手提示：同样排在 flex 流里，不做浮层 -->
  <view class="guide" wx:if="{{guideStep > 0}}">
    <view class="guide-n">{{guideStep}}/3</view>
    <view class="guide-text">{{guideText}}</view>
    <view class="guide-skip" bindtap="onGuideSkip">跳过</view>
  </view>

  <view class="stage">
    <canvas
      type="webgl"
      id="webgl"
      class="gl"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtap="onTap"
    ></canvas>
  </view>

  <!-- 底部面板（普通流式布局，不覆盖画布） -->
  <view class="panel {{panelOpen?'open':''}}">
    <view class="panel-bar" bindtap="onTogglePanel">
      <view class="bar-title">{{tabName}}</view>
      <view class="bar-arrow">{{panelOpen ? '收起' : '展开'}}</view>
    </view>

    <scroll-view wx:if="{{panelOpen}}" scroll-y class="panel-body">
      <!-- 常用操作 -->
      <view class="ops">
        <view class="op" bindtap="onAdd">投放物体</view>
        <view class="op" bindtap="onShake">推一把</view>
        <view class="op" bindtap="onClear">清空</view>
        <view class="op" bindtap="onResetView">复位视角</view>
      </view>

      <!-- 分组切换 -->
      <view class="tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="id"
          class="tab {{tab===item.id?'on':''}}"
          data-t="{{item.id}}"
          bindtap="onTab"
        >{{item.name}}</view>
      </view>

      <!-- 一键场景预设：只属于「风浪」。以前每个页签都显示它，
           白占一行，把真正的控件挤到看不见的地方 -->
      <view wx:if="{{tab==='wave'}}" class="presets">
        <view
          wx:for="{{presets}}"
          wx:key="id"
          class="preset {{preset===item.id?'on':''}}"
          data-p="{{item.id}}"
          bindtap="onPreset"
        >{{item.name}}</view>
      </view>

      <!-- 投放类型：选好之后点水面就丢这个 -->
      <view wx:if="{{tab==='body'}}" class="row">
        <view class="row-head">
          <text class="lab">点水面丢什么</text>
          <text class="val">{{dropTypeName}}</text>
        </view>
        <view class="chips">
          <view
            wx:for="{{objectTypes}}"
            wx:key="id"
            class="chip {{dropType===item.id?'on':''}}"
            data-t="{{item.id}}"
            bindtap="onDropType"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 菲涅尔反射开关：要先于「反射强度」滑块出现，否则滑块=开关的子项却排在前面 -->
      <view wx:if="{{tab==='water'}}" class="row">
        <view class="row-head">
          <text class="lab">菲涅尔反射</text>
          <text class="val">{{params.fresnelOn ? '开 · 平视处像镜面' : '关 · 纯水色'}}</text>
        </view>
        <switch checked="{{params.fresnelOn}}" bindchange="onFresnelToggle" color="#2f8fd0" />
      </view>

      <!-- 滑块组 -->
      <block wx:if="{{tab!=='light' && tab!=='sound'}}">
        <view class="row" wx:for="{{sliders}}" wx:key="key" wx:if="{{item.group===tab}}">
          <view class="row-head">
            <text class="lab">{{item.label}}</text>
            <text class="val">{{params[item.key]}}{{item.unit}}</text>
          </view>
          <slider
            min="{{item.min}}"
            max="{{item.max}}"
            step="{{item.step}}"
            value="{{params[item.key]}}"
            data-key="{{item.key}}"
            data-group="{{item.group}}"
            bindchanging="onSlider"
            activeColor="#2f8fd0"
            block-size="18"
          />
        </view>
      </block>

      <!-- 水色 -->
      <view wx:if="{{tab==='water'}}" class="row">
        <view class="row-head"><text class="lab">水色</text></view>
        <view class="swatches">
          <view
            wx:for="{{waterColors}}"
            wx:key="*this"
            class="sw {{params.waterColor===item?'on':''}}"
            style="background:{{item}}"
            data-c="{{item}}"
            bindtap="onWaterColor"
          ></view>
        </view>
      </view>

      <!-- 灯光 -->
      <block wx:if="{{tab==='light'}}">
        <!-- 阳光：时刻是唯一输入，太阳高度/方位都由它算出来 -->
        <view class="sect">
          <view class="sect-title">阳光</view>
          <view class="chips">
            <view
              wx:for="{{timePresets}}"
              wx:key="id"
              class="chip {{timePreset===item.id?'on':''}}"
              data-t="{{item.id}}"
              bindtap="onTimePreset"
            >{{item.name}}</view>
          </view>
          <view class="row">
            <view class="row-head">
              <text class="lab">时刻</text>
              <text class="val">{{sunText}}</text>
            </view>
            <slider
              min="0" max="24" step="0.1"
              value="{{timeOfDay}}"
              bindchanging="onTimeSlider"
              activeColor="#f0b429" block-size="18"
            />
          </view>
          <view class="row">
            <view class="row-head">
              <text class="lab">阳光强度</text>
              <text class="val">{{params.sunStrength}}×</text>
            </view>
            <slider
              min="0" max="2" step="0.05"
              value="{{params.sunStrength}}"
              bindchanging="onSunStrength"
              activeColor="#f0b429" block-size="18"
            />
          </view>
        </view>

        <!-- 石灯笼：三盏一次只显示一盏。以前三盏竖向堆叠，面板要滑很久 -->
        <view class="sect">
          <view class="sect-title">石灯笼</view>
          <view class="chips">
            <view
              wx:for="{{params.lights}}"
              wx:for-index="li"
              wx:key="li"
              class="chip {{lampIdx===li?'on':''}}"
              data-i="{{li}}"
              bindtap="onLampPick"
            >灯 {{li + 1}}{{item.on ? '' : ' · 灭'}}</view>
          </view>

          <view class="lamp-head">
            <text class="lab">{{params.lights[lampIdx].on ? '亮着' : '已熄灭'}}</text>
            <switch
              checked="{{params.lights[lampIdx].on}}"
              data-i="{{lampIdx}}"
              bindchange="onLampToggle"
              color="#2f8fd0"
            />
          </view>

          <view class="swatches">
            <view
              wx:for="{{lampColors}}"
              wx:for-item="c"
              wx:key="*this"
              class="sw {{params.lights[lampIdx].color===c?'on':''}}"
              style="background:{{c}}"
              data-i="{{lampIdx}}"
              data-c="{{c}}"
              bindtap="onLampColor"
            ></view>
          </view>

          <view class="row" wx:for="{{lampSliders}}" wx:for-item="s" wx:key="key" wx:if="{{s.key==='intensity' || lampMore}}">
            <view class="row-head">
              <text class="lab">{{s.label}}</text>
              <text class="val">{{params.lights[lampIdx][s.key]}}{{s.unit}}</text>
            </view>
            <slider
              min="{{s.min}}" max="{{s.max}}" step="{{s.step}}"
              value="{{params.lights[lampIdx][s.key]}}"
              data-i="{{lampIdx}}" data-key="{{s.key}}"
              bindchanging="onLampSlider"
              activeColor="#2f8fd0" block-size="18"
            />
          </view>

          <!-- 方位/离池边/灯芯高度先收起来：默认只留亮度，这一屏才装得下 -->
          <view class="more" bindtap="onLampMore">{{lampMore ? '收起参数' : '更多参数（方位 / 离池边 / 高度）'}}</view>
        </view>
      </block>

      <!-- 声音 -->
      <block wx:if="{{tab==='sound'}}">
        <view class="row">
          <view class="row-head"><text class="lab">开启声音</text></view>
          <switch checked="{{params.soundOn}}" bindchange="onSoundToggle" color="#2f8fd0" />
        </view>
        <view class="row" wx:for="{{soundSliders}}" wx:key="key">
          <view class="row-head">
            <text class="lab">{{item.label}}</text>
            <text class="val">{{params[item.key]}}</text>
          </view>
          <slider
            min="{{item.min}}" max="{{item.max}}" step="{{item.step}}"
            value="{{params[item.key]}}"
            data-key="{{item.key}}"
            bindchanging="onSoundSlider"
            activeColor="#2f8fd0" block-size="18"
          />
        </view>
        <view class="tip">声音全部实时合成，不占包体积；首次开启需点一下屏幕才能出声。</view>
      </block>

      <view class="pad"></view>
    </scroll-view>

    <!-- 放在 scroll-view 之后才会画在它上面；纯视觉提示，不吃触摸 -->
    <view class="panel-fade" wx:if="{{panelOpen}}"></view>
  </view>
</view>

.page {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #cfe6f5;
}

/* 顶部工具条：在画布外，保证一定可见 */
.topbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  background: #eaf4fb;
  border-bottom: 1rpx solid rgba(47, 143, 208, 0.14);
}

.stage {
  flex: 1 1 auto;
  min-height: 0;
  position: relative;
  overflow: hidden;
}

.gl {
  width: 100%;
  height: 100%;
  display: block;
}

.seg {
  display: flex;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 6rpx;
  pointer-events: auto;
  box-shadow: 0 4rpx 16rpx rgba(47, 143, 208, 0.18);
}
.seg-item {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #62808f;
  border-radius: 999rpx;
}
.seg-item.on {
  background: #2f8fd0;
  color: #fff;
  font-weight: 600;
}
.stat {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  color: #33505f;
  box-shadow: 0 4rpx 16rpx rgba(47, 143, 208, 0.18);
}
.help {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #2f8fd0;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(47, 143, 208, 0.18);
  box-sizing: border-box;
  border: 1rpx solid rgba(47, 143, 208, 0.25);
}

/* 三步上手提示：排在 flex 流里（不是浮层），所以一定会显示出来。
   flex: 0 0 auto 让它吃掉的画布高度固定，不会跟着 flex 分配变化。 */
.guide {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff8e3;
  border-bottom: 1rpx solid rgba(214, 158, 46, 0.25);
}
.guide-n {
  flex: 0 0 auto;
  background: #f0b429;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.guide-text {
  flex: 1 1 auto;
  font-size: 26rpx;
  color: #6b5410;
}
.guide-skip {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: #a08a4a;
  padding: 6rpx 8rpx;
}

/* 场景预设：4 个并排，选中高亮 */
.presets {
  display: flex;
  gap: 12rpx;
  margin: 0 0 18rpx;
}
.preset {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: #62808f;
  background: #f2f8fc;
  border: 1rpx solid rgba(47, 143, 208, 0.18);
  border-radius: 14rpx;
}
.preset.on {
  background: #2f8fd0;
  border-color: #2f8fd0;
  color: #fff;
  font-weight: 600;
}

/* 物体类型小标签，可换行 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0 4rpx;
}
.chip {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #33505f;
  background: #f2f8fc;
  border: 1rpx solid rgba(47, 143, 208, 0.16);
  border-radius: 999rpx;
}
.chip.on {
  background: #2f8fd0;
  border-color: #2f8fd0;
  color: #fff;
  font-weight: 600;
}

/* 页签里的小区块（阳光 / 石灯笼）。
   加一道分隔线，否则一堆滑块堆在一起分不清哪些属于灯、哪些属于太阳 */
.sect {
  border-top: 1rpx solid rgba(47, 143, 208, 0.12);
  padding-top: 12rpx;
  margin-top: 10rpx;
}
.sect:first-child { border-top: none; margin-top: 0; }
.sect-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1c2b36;
  margin: 6rpx 0 2rpx;
}
.more {
  font-size: 24rpx;
  color: #2f8fd0;
  padding: 14rpx 0 20rpx;
  text-align: center;
}

/* 加载 */
.loading {
  position: absolute;
  left: 0; right: 0; top: 45%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.spin {
  width: 60rpx; height: 60rpx;
  border: 6rpx solid rgba(47, 143, 208, 0.25);
  border-top-color: #2f8fd0;
  border-radius: 50%;
  animation: sp 0.9s linear infinite;
}
@keyframes sp { to { transform: rotate(360deg); } }
.loading-text {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #33505f;
}

/* 底部面板：普通流式布局，展开时挤压画布，不做覆盖层 */
.panel {
  position: relative;      /* 给底部的渐隐提示做定位基准 */
  flex: 0 0 auto;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(47, 143, 208, 0.18);
  /* 展开时给画布留够空间：整屏减去顶栏(~8vh)后，画面还能占一半左右 */
  max-height: 52vh;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

/* 内容超出一屏时，底部渐隐——不然最后一个滑块被切一半，
   看起来像坏了，其实只是提示「下面还有」。pointer-events 关掉，不挡滑动。 */
.panel-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  height: 44rpx;
  pointer-events: none;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.96));
}
.panel-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx;
  border-bottom: 1rpx solid rgba(47, 143, 208, 0.14);
}
.bar-title { font-size: 29rpx; font-weight: 600; color: #1c2b36; }
.bar-arrow { font-size: 25rpx; color: #2f8fd0; }

.panel-body {
  /* 底部留出 28rpx：不留的话最后一个滑块会贴在面板边缘，看着像被切掉了 */
  padding: 8rpx 32rpx 28rpx;
  box-sizing: border-box;
  /* scroll-view 要能滚必须给确定高度；固定值还能让切 tab 时面板不跳高 */
  height: 42vh;
}

.ops {
  display: flex;
  /* 强制一行：四个按钮换行会多占一整行，面板高度本来就紧张 */
  flex-wrap: nowrap;
  gap: 10rpx;
  margin: 14rpx 0 18rpx;
}
.op {
  flex: 1 1 0;
  min-width: 0;
  text-align: center;
  padding: 15rpx 4rpx;
  font-size: 24rpx;
  color: #2f8fd0;
  background: #eef6fb;
  border-radius: 14rpx;
  white-space: nowrap;
}

.tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: #62808f;
  background: #eef6fb;
  border-radius: 12rpx;
}
.tab.on {
  background: #2f8fd0;
  color: #fff;
  font-weight: 600;
}

.row { margin: 14rpx 0 18rpx; }
.row-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 2rpx;
}
.lab { font-size: 26rpx; color: #33505f; }
.val { font-size: 24rpx; color: #2f8fd0; font-weight: 600; }

.swatches { display: flex; gap: 14rpx; margin: 12rpx 0 8rpx; }
.sw {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
}
.sw.on { border-color: #1c2b36; }

.lamp {
  border: 1rpx solid rgba(47, 143, 208, 0.16);
  border-radius: 18rpx;
  padding: 18rpx 20rpx 6rpx;
  margin-bottom: 18rpx;
}
.lamp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.lamp-title { font-size: 27rpx; font-weight: 600; color: #1c2b36; }

.tip { font-size: 23rpx; color: #8aa3b0; line-height: 36rpx; margin: 12rpx 0; }
.pad { height: 40rpx; }

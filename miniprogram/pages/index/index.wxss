.page {
  padding: 48rpx 32rpx 64rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin-bottom: 40rpx;
}
.title {
  font-size: 64rpx;
  font-weight: 700;
  color: #2f8fd0;
  letter-spacing: 4rpx;
}
.sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #62808f;
}

.card {
  background: #fff;
  border: 1rpx solid rgba(47, 143, 208, 0.22);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(47, 143, 208, 0.1);
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
}

.row {
  font-size: 27rpx;
  line-height: 46rpx;
  color: #33505f;
}
.hint {
  color: #8aa3b0;
  font-size: 24rpx;
}

.notice-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1c2b36;
  margin-bottom: 12rpx;
}

.enter {
  margin: 24rpx 0 32rpx;
  background: linear-gradient(135deg, #48a9e6, #2f8fd0);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(47, 143, 208, 0.35);
}
.enter::after { border: none; }

.seg {
  display: flex;
  background: #eef6fb;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 8rpx 0 14rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 27rpx;
  color: #62808f;
  border-radius: 12rpx;
}
.seg-item.on {
  background: #fff;
  color: #2f8fd0;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(47, 143, 208, 0.18);
}

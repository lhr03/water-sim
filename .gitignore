# 依赖
node_modules/

# 微信小程序：开发者工具「构建 npm」的产物
miniprogram_npm/

# 由 scripts/sync-vendor.mjs 从 node_modules 生成，不入库
vendor/

# 打包产物
dist/
build/
*.spec
app.ico

# 例外：小程序分包里按 import 图抽取的依赖要入库（上面的 build/ 会误伤 three.module.js）
!miniprogram/pkg-water/lib/
!miniprogram/pkg-water/lib/**
!miniprogram/pkg-water/lib/build/
!miniprogram/pkg-water/lib/build/**

# Python
__pycache__/
*.pyc
*.pyo

# 日志与临时文件
*.log
.chrome/
.chrome2/
.tmp/
.DS_Store
Thumbs.db
